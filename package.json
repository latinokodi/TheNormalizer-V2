{
  "name": "thenormalizer",
  "version": "2.0.0",
  "private": true,
  "description": "Peak-normalize video and audio files, copying the picture and re-encoding only the sound.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm --prefix frontend run dev\" \"wait-on http://127.0.0.1:5173 && cross-env THE_NORMALIZER_DEV=http://127.0.0.1:5173 electron .\"",
    "build": "npm --prefix frontend run build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron": "^33.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.thenormalizer.app",
    "productName": "TheNormalizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
